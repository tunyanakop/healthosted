# Скопируй этот файл в .env: cp .env.example .env
# Значения ниже — рабочие дефолты для локального запуска.
# Для доступа из локальной сети поменяй BIND_ADDR (см. README).

# Путь к SQLite. В контейнере — том /data.
# Локально (npm run dev): file:./dev.db — файл появится в каталоге prisma/
DATABASE_URL="file:./dev.db"

# Каталог для загруженных файлов (вне public/)
DATA_DIR="./data"

# Порт приложения
PORT="3000"

# Адрес, на котором публикуется порт:
#   127.0.0.1 — только этот сервер (безопасный дефолт)
#   0.0.0.0   — вся локальная сеть (например, http://192.168.1.10:3000)
BIND_ADDR="127.0.0.1"

# Источники данных о среде (раздел «Сезон»).
# ENV_WEATHER_PROVIDER: auto (по умолчанию) | open-meteo | met.no | wttr.in
# Если open-meteo недоступен с сервера — поставь met.no: он отдаёт погоду без ключа.
ENV_WEATHER_PROVIDER="auto"
# ENV_AIR_PROVIDER=none отключает запросы к air-quality (воздух и пыльца).
ENV_AIR_PROVIDER="open-meteo"
